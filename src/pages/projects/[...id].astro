---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import Base from '../../layouts/Base.astro';
import RotationDemo from '../../components/RotationDemo.astro';
export async function getStaticPaths() {
  const projects = await getCollection('projects', ({ data }) => import.meta.env.DEV || !data.draft);
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}
interface Props { project: CollectionEntry<'projects'>; }
const { project } = Astro.props;
const { Content, headings } = await render(project);
---
<Base title={project.data.title} description={project.data.description}>
  <div class="wrap">
    <header class="project-header">
      <a class="back-link" href="/#projects"><span aria-hidden="true">←</span> All projects</a>
      <p class="eyebrow">{project.data.category} / {project.data.kind}{project.data.draft && ' / Draft'}</p>
      <h1>{project.data.shortTitle ?? project.data.title}{project.data.subtitle && <span>{project.data.subtitle}</span>}</h1>
      <p class="project-lead">{project.data.description}</p>
      <ul class="tags" aria-label="Project topics">{project.data.tags.map((tag) => <li>{tag}</li>)}</ul>
      <div class="actions">
        {project.data.demo && <a class="button" href="#interactive-demo">Try the rotation demo <span aria-hidden="true">↓</span></a>}
        {project.data.repository && <a class="text-link" href={project.data.repository}>Explore the code on GitHub <span aria-hidden="true">↗</span></a>}
        {project.data.demonstration && <a class="text-link" href={project.data.demonstration}>View demonstration <span aria-hidden="true">↗</span></a>}
      </div>
    </header>
    {project.data.results && <section class="results-section" aria-labelledby="results-title">
      <div><p class="eyebrow">Results at a glance</p><h2 id="results-title">Same model. A different perspective.</h2><p>Direct-mutation prediction RMSE, in kcal/mol. Lower is better.</p></div>
      <div class="table-scroll"><table class="results-table"><caption>Benchmark results reported in my conference abstract</caption>
        <thead><tr><th scope="col">Dataset</th><th scope="col">Baseline</th><th scope="col">With RoDA</th><th scope="col">Reduction</th></tr></thead>
        <tbody>{project.data.results.map((result) => <tr><th scope="row">{result.dataset}</th><td>{result.baseline.toFixed(2)}</td><td class="accent">{result.augmented.toFixed(2)}</td><td>{(result.baseline - result.augmented).toFixed(2)}</td></tr>)}</tbody>
      </table></div>
    </section>}
    <div class="project-reading"><aside class="contents"><nav aria-label="On this page"><p class="eyebrow">On this page</p><ul>{headings.filter(({ depth }) => depth === 2).map((heading) => <li><a href={`#${heading.slug}`}>{heading.text}</a></li>)}{project.data.demo && <li><a href="#interactive-demo">Interactive demo</a></li>}</ul></nav></aside><article class="prose"><Content /></article></div>
    {project.data.demo === 'rotation' && <section id="interactive-demo" class="demo-section" aria-labelledby="demo-title"><p class="eyebrow">Explore the idea</p><h2 id="demo-title">Give the data a spin.</h2><p class="section-intro">Apply the same rotation to a schematic wild-type and mutant pair. The spatial representation changes; the experimental ΔΔG label stays the same.</p><RotationDemo /></section>}
    <div class="project-end"><a class="text-link" href="/#projects"><span aria-hidden="true">←</span> Back to selected work</a>{project.data.repository && <a class="text-link" href={project.data.repository}>View the project on GitHub <span aria-hidden="true">↗</span></a>}</div>
  </div>
</Base>
