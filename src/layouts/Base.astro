---
import '../styles/global.css';
interface Props { title: string; description: string; }
const { title, description } = Astro.props;
const canonical = new URL(Astro.url.pathname, Astro.site);
---
<!doctype html>
<html lang="en-AU">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#101416" />
    <meta name="description" content={description} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="canonical" href={canonical} />
    <meta property="og:title" content={`${title} | Andrew Harrison`} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content="website" />
    <title>{title} | Andrew Harrison</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header wrap">
      <a class="wordmark" href="/" aria-label="Andrew Harrison, home"><span class="monogram" aria-hidden="true">ah<span>.</span></span><span>Andrew Harrison</span></a>
      <nav aria-label="Main navigation"><a href="/#projects">Projects</a><a href="/#about">About</a><a href="https://github.com/andrewharrisonGH">GitHub <span aria-hidden="true">↗</span></a></nav>
    </header>
    <main id="main"><slot /></main>
    <footer class="site-footer wrap"><a class="footer-name" href="/">Andrew Harrison <span aria-hidden="true">/</span> Bioinformatics & code</a><a href="https://github.com/andrewharrisonGH/portfolio">Website source <span aria-hidden="true">↗</span></a></footer>
  </body>
</html>
